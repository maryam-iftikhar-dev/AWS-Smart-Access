# ==============================================================================
# AWS Smart Access & Campus IT Assistant - Backend Environment Variables
# Copy this file to .env and replace with your actual AWS and Groq credentials.
# ==============================================================================

# ---- AWS Academy Learner Lab Credentials (temporary session credentials) ----
# Paste directly from AWS Academy "AWS Details > AWS CLI":
aws_access_key_id=YOUR_AWS_ACCESS_KEY_ID
aws_secret_access_key=YOUR_AWS_SECRET_ACCESS_KEY
aws_session_token=YOUR_AWS_SESSION_TOKEN

# ---- AWS Cloud Configuration ----
AWS_REGION=us-east-1
PORT=4000
LIVENESS_THRESHOLD=90
FRONTEND_ORIGIN=http://localhost:5173

# ---- Bedrock Model ID ----
# (Used if invoking Bedrock ConverseCommand directly)
BEDROCK_MODEL_ID=mistral.mistral-7b-instruct-v0:2

# ---- Groq API Key (High-Speed LLM Inference) ----
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
